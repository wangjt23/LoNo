{
  "name": "shiguang-reminder",
  "version": "0.2.0",
  "description": "本地优先的智能工作提醒助手",
  "author": "Shiguang contributors",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:desktop": "node scripts/smoke.mjs",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win portable --x64",
    "dist:win:signed": "electron-builder --config electron-builder.signed.cjs --win portable --x64"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "imapflow": "^2.10.0",
    "mailparser": "^3.9.0",
    "sql.js": "^1.13.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright": "^1.56.0"
  },
  "build": {
    "appId": "com.shiguang.reminder",
    "productName": "Shiguang Reminder",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/sql.js/dist/{sql-asm*,worker*,*debug*,*inline*,*browser*,*.zip}"
    ],
    "asar": true,
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Shiguang-Reminder-${version}-win-x64.exe"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
